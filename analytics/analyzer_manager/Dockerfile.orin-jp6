# Start FROM Nvidia ML image 
FROM lumixai/analytic_base:0.1.0-orin-jp6

# set environment
ENV LC_CTYPE=en_US.UTF-8

# Install python dependencies base
COPY jetson_requirements.txt constraints.txt  . 

RUN pip3 install -r jetson_requirements.txt  -c constraints.txt
RUN pip3 install onnx~=1.17.0 qudida>=0.0.4 albumentations~=1.3.1 ultralytics==8.0.222 lap --no-deps

COPY ./python_library/orin-jp6 /tmp/whl
RUN for f in /tmp/whl/*.whl; do pip3 install "$f" --no-deps; done

# COPY ./inference/libs/jetpack6/ /usr/lib/aarch64-linux-gnu/nvidia/

# ENV LD_PRELOAD=/usr/local/lib/python3.10/dist-packages/scikit_learn.libs/libgomp-d22c30c5.so.1.0.0
ENV HOST=orin
ENV JETPACK=6
