# Start FROM Nvidia ML image 
FROM nvcr.io/nvidia/l4t-ml:r32.6.1-py3

# Install linux packages
RUN apt update && apt install -y python3-tk 

# set environment
ENV LC_CTYPE=en_US.UTF-8

COPY ./python_library/nvjpeg.cpython-36m-aarch64-linux-gnu.so /usr/local/lib/python3.6/dist-packages/
COPY ./python_library/pynvjpeg-0.0.13.dist-info/ /usr/local/lib/python3.6/dist-packages/

RUN mkdir -p /usr/lib/python3.6/dist-packages/jetson/
RUN mkdir -p /usr/lib/python3.6/dist-packages/jetson/utils/
RUN mkdir -p /usr/lib/python3.6/dist-packages/jetson/inference/

COPY ./python_library/jetson/__init__.py /usr/lib/python3.6/dist-packages/jetson/__init__.py
COPY ./python_library/jetson/utils/__init__.py /usr/lib/python3.6/dist-packages/jetson/utils/
COPY ./python_library/jetson/inference/__init__.py /usr/lib/python3.6/dist-packages/jetson/inference/

COPY ./python_library/jetson_inference_python.so /usr/lib/python3.6/dist-packages/
COPY ./python_library/jetson_utils_python.so /usr/lib/python3.6/dist-packages/
COPY ./python_library/libjetson-inference.so /usr/local/lib/libjetson-inference.so
COPY ./python_library/libjetson-utils.so /usr/local/lib/libjetson-utils.so
COPY ./python_library/libGLEW.so.2.0 /usr/local/lib/libGLEW.so.2.0

# Install python dependencies
COPY jetson_requirements.txt .
 
RUN pip3 install -r jetson_requirements.txt

RUN python3 -m pip install --upgrade pip
RUN pip3 install --ignore-requires-python ultralytics>=8.0.188 --no-deps
RUN pip3 install qudida>=0.0.4 albumentations~=1.3.1 --no-deps

COPY ./python_library/xavier /tmp/whl
RUN for f in /tmp/whl/*.whl; do pip3 install "$f"; done

ENV HOST=xavier
ENV TRITON_ENABLED='False'
