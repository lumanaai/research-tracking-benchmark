# Start FROM Nvidia ML image 
FROM nvcr.io/nvidia/l4t-ml:r35.2.1-py3

# Install linux packages
RUN apt update && apt install -y python3-tk

# set environment
ENV LC_CTYPE=en_US.UTF-8

# Install python dependencies base
COPY jetson_requirements.txt .

RUN pip3 install -r jetson_requirements.txt
RUN pip3 install ultralytics==8.0.222 qudida>=0.0.4 albumentations~=1.3.1  lap~=0.4.0 --no-deps

COPY ./python_library/orin /tmp/whl
RUN for f in /tmp/whl/*.whl; do pip3 install "$f"; done

COPY ./python_library/orin/exports /tmp/whl/exports

ENV LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libGLdispatch.so.0:/usr/lib/aarch64-linux-gnu/libgomp.so.1:/usr/local/lib/python3.8/dist-packages/scikit_learn.libs/libgomp-d22c30c5.so.1.0.0
ENV HOST=orin
ENV JETPACK=5
