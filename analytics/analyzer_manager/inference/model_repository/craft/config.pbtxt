name: "craft"
backend: "tensorrt"
input [
  {
    name: "input"
    data_type: TYPE_FP16
    dims: [ -1, 3, 384, 640 ]
  }
]
output [
  {
    name: "text"
    data_type: TYPE_FP16
    dims: [-1, 192, 320, 2]
  },
  {
    name: "features"
    data_type: TYPE_FP16
    dims: [-1, 32,  192, 320]
  }
]
model_warmup [
  {
	batch_size: 1
	inputs {
		key: "input"
		value: {
			data_type: TYPE_FP16
			dims: [1, 3, 384, 640 ]
			zero_data: true
			}
		}
   }
]