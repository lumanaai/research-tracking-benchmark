FROM nvcr.io/nvidia/deepstream-l4t:7.0-triton-multiarch

COPY ./libs/jetpack6/ /usr/lib/aarch64-linux-gnu/nvidia/

# remove backends to preserve ram
WORKDIR /opt/tritonserver/backends
RUN  mv pytorch python onnxruntime tensorflow /mnt/

# Set working directory
WORKDIR /opt/tritonserver

# set path of executable
ENV PATH="$PATH:/opt/tritonserver/bin"