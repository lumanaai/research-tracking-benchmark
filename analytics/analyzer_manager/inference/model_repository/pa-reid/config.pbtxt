name: "pa-reid"
backend: "tensorrt"
max_batch_size : 0
input [
  {
    name: "input"
    data_type: TYPE_FP16
    dims: [ -1, 3, 256, 128 ]
  }
]
output [
  {
    name: "output"
    data_type: TYPE_FP16
    dims: [ -1, 512 ]
  }
]
model_warmup [
  {
	batch_size: 1
	inputs {
		key: "input"
		value: {
			data_type: TYPE_FP16
			dims: [ 4, 3, 256, 128 ]
			random_data: true
			}
		}
   }
]
