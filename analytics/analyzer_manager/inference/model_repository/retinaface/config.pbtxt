name: "retinaface"
backend: "tensorrt"
input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ -1, 3, 180, 180 ]
  }
]
output [
  {
    name: "boxes"
    data_type: TYPE_FP32
    dims: [-1, 1418, 4 ]
  },
  {
    name: "confs"
    data_type: TYPE_FP32
    dims: [-1, 1418, 2 ]
  },
   {
    name: "landmarks"
    data_type: TYPE_FP32
    dims: [-1, 1418, 10 ]
  }
]
model_warmup [
  {
	batch_size: 1
	inputs {
		key: "input"
		value: {
			data_type: TYPE_FP32
			dims: [ 1, 3, 180, 180 ]
			zero_data: true
			}
		}
   }
]