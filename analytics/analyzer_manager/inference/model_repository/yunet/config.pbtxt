name: "yunet"
backend: "tensorrt"
input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 1, 3, 120, 160 ]
  }
]
output [
  {
    name: "loc"
    data_type: TYPE_FP32
    dims: [1076, 14 ]
  },
  {
    name: "conf"
    data_type: TYPE_FP32
    dims: [1076, 2 ]
  },
   {
    name: "iou"
    data_type: TYPE_FP32
    dims: [1076, 1 ]
  }
]
model_warmup [
  {
	batch_size: 1
	inputs {
		key: "input"
		value: {
			data_type: TYPE_FP32
			dims: [ 1, 3, 120, 160 ]
			zero_data: true
			}
		}
   }
]
